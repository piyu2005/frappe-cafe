# Dependency directories
node_modules/
jspm_packages/

# This project uses yarn (frontend/yarn.lock is the real, committed lockfile)
# - an npm lockfile here means someone ran `npm install` instead at some
# point, and npm/yarn resolving the same package.json independently can
# silently disagree on transitive versions.
frontend/package-lock.json

# IDEs and editors
.vscode/
.vs/
.idea/
.kdev4/
*.kdev4
*.DS_Store
*.swp
*.comp.js
.wnf-lang-status
*debug.log

# Helix Editor
.helix/

# Aider AI Chat
.aider*

# Frontend build output is committed (see my_new_app/public/frontend/) rather
# than gitignored — Frappe Cloud wasn't running the `yarn build` step on
# deploy, leaving the site referencing asset files that never existed on the
# server. Committing the actual build makes the site work regardless of
# whether that step ever runs there. Re-run `cd frontend && yarn build`
# and commit the result after any frontend change.
my_new_app/public/frontend/assets/*.map
