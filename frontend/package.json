{
  "name": "frappe-ui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp ../cafe/www/index.html ../cafe/www/me.html",
    "preview": "vite preview",
    "build:hljs": "esbuild src/island/hljs-entry.js --bundle --minify --format=iife --outfile=../cafe/public/builder_assets/vendor/highlight.min.js",
    "build:write-editor": "esbuild src/island/write-editor-entry.js --bundle --minify --format=iife --outfile=../cafe/public/builder_assets/vendor/write-editor.min.js",
    "build:chat-editor": "esbuild src/island/chat-editor-entry.js --bundle --minify --format=iife --outfile=../cafe/public/builder_assets/vendor/chat-editor.min.js"
  },
  "dependencies": {
    "frappe-ui": "1.0.0-beta.29",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.2",
    "lucide-static": "^0.400.0",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.4.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.4.0"
  }
}
